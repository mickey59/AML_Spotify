    "song_features = ['Danceability', 'Energy', 'Speechiness', 'Acousticness', 'Instrumentalness', 'Valence', 'track_popularity', 'artist_followers', 'artist_popularity', 'Loudness', 'explicit_False', 'explicit_True', 'Nationality_albania', 'Nationality_algeria', 'Nationality_argentina', 'Nationality_australia', 'Nationality_austria', 'Nationality_azerbaijan', 'Nationality_barbados', 'Nationality_belgium', 'Nationality_bonaire', 'Nationality_brazil', 'Nationality_canada', 'Nationality_chili', 'Nationality_colombia', 'Nationality_costa rica', 'Nationality_cuba', 'Nationality_czech republic', 'Nationality_denmark', 'Nationality_dominican republic', 'Nationality_ecuador', 'Nationality_finland', 'Nationality_france', 'Nationality_germany', 'Nationality_ghana', 'Nationality_greece', 'Nationality_iceland', 'Nationality_india', 'Nationality_indonesia', 'Nationality_ireland', 'Nationality_israel', 'Nationality_italy', 'Nationality_jamaica', 'Nationality_japan', 'Nationality_kazakhstan', 'Nationality_kosovo', 'Nationality_lithuania', 'Nationality_malta', 'Nationality_mexico', 'Nationality_moldavia', 'Nationality_morocco', 'Nationality_netherlands', 'Nationality_new zealand', 'Nationality_nigeria', 'Nationality_norway', 'Nationality_pakistan', 'Nationality_panama', 'Nationality_philippines', 'Nationality_poland', 'Nationality_portugal', 'Nationality_puerto rico', 'Nationality_romania', 'Nationality_russia', 'Nationality_scotland', 'Nationality_south africa', 'Nationality_south korea', 'Nationality_spain', 'Nationality_sri lanka', 'Nationality_suecia', 'Nationality_sweden', 'Nationality_swiss', 'Nationality_thailand', 'Nationality_turkey', 'Nationality_ukraine', 'Nationality_united kingdom', 'Nationality_united states', 'Nationality_unknown', 'Nationality_venezuela', 'Continent_africa', 'Continent_anglo-america', 'Continent_asia', 'Continent_europe', 'Continent_latin-america', 'Continent_oceania', 'Continent_unknown', 'detected_languages_ARABIC', 'detected_languages_AZERBAIJANI', 'detected_languages_BENGALI', 'detected_languages_BOSNIAN', 'detected_languages_CATALAN', 'detected_languages_CHINESE', 'detected_languages_DANISH', 'detected_languages_DUTCH', 'detected_languages_ENGLISH', 'detected_languages_ENGLISH, TAGALOG', 'detected_languages_FINNISH', 'detected_languages_FRENCH', 'detected_languages_GERMAN', 'detected_languages_GREEK', 'detected_languages_HEBREW', 'detected_languages_HINDI', 'detected_languages_HUNGARIAN', 'detected_languages_INDONESIAN', 'detected_languages_ITALIAN', 'detected_languages_JAPANESE', 'detected_languages_KOREAN', 'detected_languages_LATVIAN', 'detected_languages_MALAY', 'detected_languages_PERSIAN', 'detected_languages_POLISH', 'detected_languages_PORTUGUESE', 'detected_languages_PUNJABI', 'detected_languages_RUSSIAN', 'detected_languages_SLOVENE', 'detected_languages_SPANISH', 'detected_languages_SWEDISH', 'detected_languages_TAGALOG', 'detected_languages_TSWANA', 'detected_languages_TURKISH', 'detected_languages_UKRAINIAN', 'detected_languages_URDU', 'detected_languages_VIETNAMESE', 'detected_languages_WELSH']\n",
    "\n",
    "X= data[song_features].values\n",
    "print(X)\n",
    "\n",
    "# normalise the data\n",
    "scaler = StandardScaler()\n",
    "X = scaler.fit_transform(X)\n",
    "# Apply PCA\n",
    "\n",
    "pca = PCA(n_components=2)\n",
    "X_pca = pca.fit_transform(X)\n",
    "\n",
    "# Add PCA components to dataframe\n",
    "data['PCA1'] = X_pca[:, 0]\n",
    "data['PCA2'] = X_pca[:, 1]\n",
    "\n",
    "# Explode artists and group\n",
    "data_exploded = data.assign(\n",
    "    Primary_Artists_List=data['Primary Artists'].str.split(', ')\n",
    ").explode('Primary_Artists_List')\n",
    "\n",
    "songs_by_artist = data_exploded.groupby('Primary_Artists_List')\n",
    "\n",
    "# pca with the y values being the genres\n",
    "y = data['artist_genres']\n",
    "\n",
    "\n",
    "# #plot the pca analysis as a scatter plot with artists being different colors\n",
    "# plt.figure(figsize=(10,7))\n",
    "# scatter = plt.scatter(X_pca[:,0], X_pca[:,1], c='blue', alpha=0.5)\n",
    "# plt.title(\"PCA of Song Features\")\n",
    "# plt.xlabel(\"Principal Component 1\")\n",
    "# plt.ylabel(\"Principal Component 2\")\n",
    "# plt.grid()\n",
    "# plt.show()\n",
    "\n",
    "# Plot each genre with different color\n",
    "\n",
    "\n",
    "plt.figure(figsize=(12, 8))\n",
    "for genre, group in data.groupby('artist_genres'):\n",
    "    if len(group) > 2:  # Only plot genres with more than 5 songs\n",
    "        plt.scatter(group['PCA1'], group['PCA2'], label=genre, alpha=0.6)\n",
    "plt.xlabel('Principal Component 1')\n",
    "plt.ylabel('Principal Component 2')\n",
    "plt.title('Songs by Genre in PCA Space')\n",
    "#plt.legend(bbox_to_anchor=(1.05, 1), loc='upper left')\n",
    "plt.tight_layout()\n",
    "plt.show() \n",
    "# then fit gaussians to the genres\n",
    "\n",
    "pca_full = PCA().fit(X)\n",
    "explained_variance = pca_full.explained_variance_ratio_\n",
    "cumulative_variance = explained_variance.cumsum()\n",
    "n_components_95 = (cumulative_variance < 0.95).sum() + 1\n",
    "print(f'Number of components for 95% variance: {n_components_95}')\n",
    "# print total components\n",
    "print(f'Total number of components: {len(explained_variance)}')\n",
    "\n",
    "\n"
   ]
