   "source": [
    "# what genres have the same semantic meanings\n",
    "# getting the word embeddings for each genre and then calculating the cosine similarity between them\n",
    "\n",
    "from pathlib import Path\n",
    "from sentence_transformers import SentenceTransformer, util\n",
    "# Compute/Load semantic embeddings (sentence-transformers) and rank by semantic + feature similarity.\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.preprocessing import normalize\n",
    "\n",
    "SEM_EMB_PATH = Path(\"../data/semantic_embeddings_normalised_data.npy\")\n",
    "genre_loc = pd.read_csv(\"../data/Features + Extracted data/unique_genres.csv\")\n",
    "genre_list = genre_loc['genre'].fillna(\"\").astype(str).tolist()\n",
    "\n",
    "\n",
    "def ensure_semantic_embeddings(model_name: str = \"all-MiniLM-L6-v2\", force_recompute: bool = False) -> np.ndarray:\n",
    "    global embeddings_dense, embeddings_is_sparse\n",
    "\n",
    "    # If already in memory and not forced, return it\n",
    "    if 'embeddings_dense' in globals() and not force_recompute:\n",
    "        return embeddings_dense\n",
    "\n",
    "    # Load from disk if available\n",
    "    if SEM_EMB_PATH.exists() and not force_recompute:\n",
    "        embeddings_dense = np.load(SEM_EMB_PATH)\n",
    "        embeddings_is_sparse = False\n",
    "        return embeddings_dense\n",
    "\n",
    "    model = SentenceTransformer(model_name)\n",
    "    # encode with batched inference; returns numpy array\n",
    "    embeddings_dense = model.encode(genre_list, show_progress_bar=True, convert_to_numpy=True)\n",
    "    np.save(SEM_EMB_PATH, embeddings_dense)\n",
    "    embeddings_is_sparse = False\n",
    "    return embeddings_dense\n",
    "\n",
    "embeddings = ensure_semantic_embeddings()\n",
    "# normalize embeddings to unit vectors so Euclidean clustering approximates cosine similarity\n",
    "embeddings_norm = normalize(embeddings, norm='l2')\n",
    "\n",
    "#  then do k means to group like genres \n",
    "from sklearn.cluster import KMeans\n",
    "n_clusters = 20 # choose an appropriate number of clusters\n",
    "kmeans = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)\n",
    "cluster_labels = kmeans.fit_predict(embeddings_norm)\n",
    "\n",
    "# print the genres in each cluster\n",
    "for cluster in range(n_clusters):\n",
    "    print(f\"Cluster {cluster}:\")\n",
    "    for genre, label in zip(genre_list, cluster_labels):\n",
    "        if label == cluster:\n",
    "            print(f\"  - {genre}\")"
   ]
  },
