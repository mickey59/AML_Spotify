   "source": [
    "# cluster instead with cosine similarity instead of euclidean\n",
    "# cluster using your precomputed cosine similarity / distance\n",
    "from sklearn.cluster import AgglomerativeClustering, SpectralClustering\n",
    "from sklearn.metrics import silhouette_score\n",
    "import numpy as np\n",
    "from sentence_transformers import util\n",
    "\n",
    "cosine_sim_matrix = util.cos_sim(embeddings, embeddings)\n",
    "# Normalize & KMeans\n",
    "from sklearn.preprocessing import normalize\n",
    "from sklearn.cluster import KMeans\n",
    "emb_norm = normalize(embeddings, norm='l2')\n",
    "kmeans = KMeans(n_clusters=10, random_state=42, n_init=10)\n",
    "labels = kmeans.fit_predict(emb_norm)   \n",
    "\n",
    "cosine_dist = 1.0 - cosine_sim_matrix                        # distance in [0,2]\n",
    "\n",
    "n_clusters = 10\n",
    "\n",
    "\n",
    "ac = AgglomerativeClustering(n_clusters=n_clusters, metric='precomputed', linkage='average')\n",
    "labels_ac = ac.fit_predict(cosine_dist)\n",
    "\n",
    "print(\"Agglomerative clusters:\")\n",
    "for c in range(n_clusters):\n",
    "    print(f\"Cluster {c}:\")\n",
    "    for genre, lab in zip(genre_list, labels_ac):\n",
    "        if lab == c:\n",
    "            print(\"  -\", genre)\n",
    "print(\"Agglomerative silhouette (precomputed distances):\",\n",
    "      silhouette_score(cosine_dist, labels_ac, metric='precomputed'))"
   ]
